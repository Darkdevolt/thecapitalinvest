# ═══════════════════════════════════════════════════════════════
# THE CAPITAL — Variables d'environnement
# ═══════════════════════════════════════════════════════════════

# ─── SUPABASE ───
# SUPABASE_URL est l'origine du projet uniquement.
# Ne pas ajouter /rest/v1, /auth/v1, /storage/v1, etc.
SUPABASE_URL=https://VOTRE_PROJET.supabase.co

# Clé publique canonique (exposée au navigateur, protégée par les règles RLS).
SUPABASE_PUBLISHABLE_KEY=VOTRE_CLE_PUBLISHABLE

# Clé secrète, strictement côté serveur. Ne jamais l'exposer au client.
SUPABASE_SECRET_KEY=VOTRE_CLE_SECRETE

# Alias hérités encore acceptés pendant la migration :
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ─── ADMINISTRATION ───
ADMIN_EMAIL=

# ─── TÂCHES PLANIFIÉES ───
# Obligatoire pour que le cron de traitement de séance fonctionne.
# Vercel l'envoie automatiquement en en-tête Authorization: Bearer <CRON_SECRET>.
# Sans cette valeur, le traitement automatique est désactivé et /api/scrape-brvm
# n'est accessible qu'à un administrateur authentifié.
CRON_SECRET=

# ─── CORS ───
# Liste blanche d'origines séparées par des virgules.
# '*' n'est appliqué qu'aux routes de lecture publiques (/api/marche, /api/boc).
# Renseignez votre domaine en production, par exemple :
# ALLOWED_ORIGIN=https://thecapitalinvest.com,https://www.thecapitalinvest.com
ALLOWED_ORIGIN=*

# ─── LIMITATION DE DÉBIT ───
# Compteur en mémoire, par instance de fonction serverless.
RATE_LIMIT_WINDOW_MS=60000
RATE_MAX_REQUESTS=100

# ─── THE CAPITAL AI ───
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ─── BARÈME DE FRAIS BRVM (optionnel) ───
# Taux appliqués aux transactions de portefeuille. Valeurs par défaut entre
# parenthèses. Modifiables sans redéploiement du code.
# FEE_COURTAGE=0.012
# FEE_TVA=0.18
# FEE_BRVM=0.0007
# FEE_DCBR=0.0005

# Note : JWT_SECRET a été retiré. L'authentification est entièrement déléguée
# à Supabase ; la variable n'était plus utilisée et sa valeur de repli codée en
# dur ('unused') rendait forgeable tout jeton signé localement.

# ─── E-MAILS (inscription, mot de passe oublié, paiements, rappels) ───
# Un seul fournisseur suffit. Sans clé, le site retombe sur les e-mails de
# Supabase (quelques envois par heure seulement).
# Brevo (gratuit, 300 e-mails/jour) : https://app.brevo.com → SMTP & API → Clés API.
BREVO_API_KEY=
# ou Resend (gratuit, 3 000/mois, domaine vérifié requis) :
# RESEND_API_KEY=
# Adresse d'expédition, vérifiée chez le fournisseur (ex. thecapitalinvest.fin@gmail.com).
MAIL_FROM=
MAIL_FROM_NAME=The Capital
# Adresse publique du site, utilisée dans les liens des e-mails.
SITE_URL=https://thecapitalinvest.vercel.app

# ID client OAuth Google (public) : bouton Google officiel, sans adresse Supabase dans la fenêtre Google.
GOOGLE_CLIENT_ID=

# The Capital AI — moteur gratuit Google Gemini (clé : aistudio.google.com). OPENAI_API_KEY est prioritaire si définie.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
