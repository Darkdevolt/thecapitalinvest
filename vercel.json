{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "crons": [
    {"path": "/api/sync-brvm", "schedule": "30 18 * * 1-5"}
  ],
  "rewrites": [
    {"source": "/api/portefeuille", "destination": "/api/vercel"},
    {"source": "/api/:path*", "destination": "/api/vercel"}
  ],
  "functions": {
    "api/vercel.js": {"maxDuration": 30}
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Access-Control-Allow-Origin", "value": "*"},
        {"key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS"},
        {"key": "Access-Control-Allow-Headers", "Content-Type, Authorization, X-Requested-With, X-Cron-Secret"},
        {"key": "Access-Control-Max-Age", "value": "86400"}
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"}
      ]
    }
  ]
}
